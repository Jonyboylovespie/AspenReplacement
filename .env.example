# Google OAuth web client; register PUBLIC_URL/auth/google/callback as its redirect URI.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
BETTERASSPEN_PUBLIC_URL=https://aspen.jonyserver.ddnsfree.com
BETTERASSPEN_BIND=0.0.0.0:5173
# Optional: defaults to .state beside app.py. Keep this directory across restarts.
# BETTERASSPEN_STATE_DIR=/var/lib/betterasspen
# Only set this if exactly one trusted reverse proxy forwards requests to Gunicorn.
# BETTERASSPEN_PROXY_HOPS=1
# If Aspen uses a different field for the authenticated student's school email:
# BETTERASSPEN_ASPEN_EMAIL_FIELD=user.email
