# Google OAuth web client; register PUBLIC_URL/auth/google/callback as its redirect URI.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
BETTERASPEN_PUBLIC_URL=https://aspen.jonyserver.ddnsfree.com
BETTERASPEN_BIND=0.0.0.0:5173
# Optional: defaults to .state beside app.py. Keep this directory across restarts.
# BETTERASPEN_STATE_DIR=/var/lib/betteraspen
# Only set this if exactly one trusted reverse proxy forwards requests to Gunicorn.
# BETTERASPEN_PROXY_HOPS=1

# AI chat is server-only. Endpoint must support the OpenAI Responses API.
BETTERASPEN_AI_API_ENDPOINT=https://api.openai.com/v1/responses
BETTERASPEN_AI_API_KEY=
# Comma-separated verified Google emails. Empty means nobody has access.
BETTERASPEN_AI_WHITELIST=
